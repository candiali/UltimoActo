  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_isadora_clue
  title: Nota de Isadora Vale
  subtitle: Directora de la Academia (1974)
  content: "\"Para que la coreograf\xEDa de 'El Lago de las Sombras' cobre vida tras
    el tel\xF3n, cada s\xEDmbolo debe orientarse a su destino:\n\n1. El Primer Pilar
    mira hacia la Luz del Alba: el Cisne Blanco.\n2. El Segundo Pilar se inclina
    hacia la Oscuridad oculta: el Cisne Negro.\n3. El Tercer Pilar aguarda frente
    al Escenario: el Tel\xF3n Teatral.\n\nSolo cuando los tres guarden silencio,
    el secreto del archivo se revelar\xE1.\""
