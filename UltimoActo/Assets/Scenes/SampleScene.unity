  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_last_rehearsal_photo
  title: "Fotograf\xEDa de las Alumnas durante el \xDAltimo Ensayo"
  subtitle: Directora de la Academia (1974)
  content: "Una fotograf\xEDa en blanco y negro tomada desde la esquina del piano
    vertical pocos d\xEDas antes del cierre.\n\nLas alumnas mantienen la quinta posici\xF3n
    en el centro del aula mirando hacia los espejos del sur.\nAl observar el reflejo
    capturado en el cristal del fondo, todas las bailarinas aparecen de frente salvo
    una figura en el extremo izquierdo cuyo reflejo permanece de espaldas, mirando
    fijamente hacia el interior del espejo."
--- !u!23 &347778930
