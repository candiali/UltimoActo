--- !u!114 &1938422229
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1938422227}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_portrait_reinterpretation
  title: "Reverso del Bastidor \u2014 'El Lago de las Sombras'"
  subtitle: Directora de la Academia (1974)
  content: "Al inspeccionar el borde inferior del lienzo con lo descubierto en la
    habitaci\xF3n privada de Elena:\n\nSe distingue una capa gruesa de \xF3leo oscuro
    aplicada apresuradamente sobre una segunda bailarina que originalmente aparec\xEDa
    detr\xE1s de Elena.\n\nGrabado a punz\xF3n en la madera del bastidor:\n\u201CRetocado
    por orden de Direcci\xF3n el 15 de octubre de 1924 \u2014 Borrar a la suplente
    de la escena principal.\u201D"
