  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n4_elena_water_note
  title: "Nota de Elena \u2014 Las Tres Notas del Agua"
  subtitle: Directora de la Academia (1974)
  content: "Una hoja de pentagrama doblada, con la letra de Elena:\n\n\xABMara y
    yo escondimos el siguiente mensaje donde el agua ya no corre. La fuente seca
    del Jard\xEDn de Invierno guarda tres grifos de cisne: \xE1brelos como suena
    la cadencia: el de la izquierda, el de la derecha y, al final, el del centro.\xBB"
