  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_isadora_letter
  title: "Carta Confidencial \u2014 Direcci\xF3n de la Academia"
  subtitle: Directora de la Academia (1974)
  content: "A los miembros de la Junta Directiva:\n\nLos incidentes durante los ensayos
    de 'El Lago de las Sombras' ya no pueden ocultarse bajo el pretexto del agotamiento.\nMara
    Bell asumir\xE1 el papel del Cisne Blanco y del Cisne Negro si Elena contin\xFAa
    manifestando estos delirios.\n\nHe ordenado custodiar los expedientes m\xE9dicos
    originales en el archivo bajo llave. Nadie debe inspeccionar las fichas del elenco
    sin mi autorizaci\xF3n expresa.\n\n\u2014 Isadora Vale, Directora"
