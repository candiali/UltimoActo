  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_locker14_elena
  title: "Taquilla N\xBA 14 (Elena Vesper) \u2014 Fotograf\xEDa Colocada al Rev\xE9s"
  subtitle: Directora de la Academia (1974)
  content: "A diferencia de las taquillas vac\xEDas, en el suelo frente a la Taquilla
    N\xBA 14 hay huellas recientes sobre el polvo.\n\nEn el estante superior hay
    una fotograf\xEDa colocada deliberadamente boca abajo y una nota escrita de pu\xF1o
    y letra de Elena:\n\u201CSi encuentras esta llave, entra en mi habitaci\xF3n
    al final del corredor norte y abre el compartimento del fondo de mi escritorio.
    All\xED dej\xE9 la prueba de que la fotograf\xEDa del pasillo fue alterada.\u201D"
