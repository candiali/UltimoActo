  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s6_original_stage_rigging_blueprint
  title: "Plano T\xE9cnico Amarillento \u2014 Disposici\xF3n Original de Decorados
    y Contrapesos"
  subtitle: Directora de la Academia (1974)
  content: "PLANO DE TRAMOYA Y SUSPENSI\xD3N ESC\xC9NICA \u2014 GRAN TEATRO VESPER\n\n\u2022
    L\xEDnea I (Contrapeso Norte): Tel\xF3n de Boca de Terciopelo Borgo\xF1a.\n\u2022
    L\xEDnea II (Contrapeso Central): Bambalinas y Puente de Luces de Proscenio.\n\u2022
    L\xEDnea III (Contrapeso Sur \u2014 Palanca Dorada): **Arco Practicable del Lago
    y Cerrojo Mec\xE1nico de Acceso al Escenario Principal**.\n\nInstrucci\xF3n de
    seguridad: \xABSi la Palanca III se deja abatida hacia atr\xE1s, el tel\xF3n
    ciego desciende y bloquea las puertas de acceso al Escenario Principal. Para
    abrir el paso al escenario, acciona el **Banco de Controles de Tramoya ([E])**
    en el centro de la sala\xBB."
