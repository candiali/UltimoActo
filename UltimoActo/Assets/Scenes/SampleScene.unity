  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n3_isadora_commission
  title: Encargo Personal de Isadora Vale al Taller
  subtitle: Directora de la Academia (1974)
  content: "Hoja de encargo reservada, hallada bajo la mesa de patronaje:\n\n\xABDos
    trajes id\xE9nticos del Cisne Negro, uno ajustado a Elena y otro a Mara. Que
    ninguna sepa del otro.\nLas copas de cristal de mi sal\xF3n deben llevar la mezcla:
    primero la tercera, luego la primera y por \xFAltimo la del centro.\n\u2014 I.
    V.\xBB"
