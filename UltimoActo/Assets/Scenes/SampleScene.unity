  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_locker11_clipping
  title: "Taquilla N\xBA 11 (Clara Valmont) \u2014 Recorte de Peri\xF3dico"
  subtitle: Directora de la Academia (1974)
  content: "Un recorte amarillento de la cr\xF3nica cultural local:\n\n\xABCRISIS
    EN LA ACADEMIA VESPER: Rumores de clausura tras la misteriosa cancelaci\xF3n
    de 'El Lago de las Sombras'. Los inspectores encontraron las taquillas de varias
    alumnas completamente vaciadas durante la madrugada del 17 de octubre.\xBB"
