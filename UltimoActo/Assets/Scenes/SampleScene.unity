  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_washbasin_inscription
  title: "Inscripci\xF3n Parcialmente Borrada en el Azulejo del Lavabo"
  subtitle: Directora de la Academia (1974)
  content: "Grabado con un objeto punzante en la junta h\xFAmeda bajo el espejo del
    \xFAltimo lavabo:\n\n\xAB18 de Octubre \u2014 El agua helada no quita el olor
    a humo ni la pintura negra de las manos.\nCerraron las verjas de la calle creyendo
    que ya no quedaba nadie adentro, pero alguien sigue abriendo las duchas cada
    madrugada.\xBB"
