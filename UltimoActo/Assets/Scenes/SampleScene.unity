  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_costume_sketches
  title: "Bocetos de los Trajes para la Representaci\xF3n Final"
  subtitle: Directora de la Academia (1974)
  content: "L\xE1minas de carboncillo y acuarela sobre la mesa de costura.\n\nEl
    dise\xF1o del Cisne Negro muestra un corpi\xF1o con trece broches de plata en
    la espalda que requer\xEDa la ayuda de otra persona para abrocharse o quitarse.\n\nAnotaci\xF3n
    escrita con l\xE1piz rojo:\n\u201CImposible que una bailarina se desvista sola
    de este traje en menos de diez minutos. Quienquiera que dej\xF3 el tut\xFA negro
    escondido tras el biombo tuvo que contar con ayuda dentro del taller.\u201D"
