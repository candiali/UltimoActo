  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_costume_name_tags
  title: "Etiquetas de Sastrer\xEDa Esc\xE9nica \u2014 Solistas"
  subtitle: Directora de la Academia (1974)
  content: "REGISTRO DE VESTUARIO DE REPRESENTACI\xD3N \u2014 TEMPORADA 1924\n\n\u2022
    Maniqu\xED I (Marfil y Oro): \xABOdette \u2014 Cisne Blanco. Asignado a: Elena
    Vesper\xBB.\n\u2022 Maniqu\xED II (Terciopelo Borgo\xF1a): \xABDama de la Corte
    \u2014 Acto I. Asignado a: Clara Valmont\xBB.\n\u2022 Maniqu\xED V (Tul Negro
    y Azabache): \xABOdile \u2014 Cisne Negro\xBB.\n\nNota de la jefa de sastrer\xEDa:\n\u201CNo
    entiendo por qu\xE9 los maniqu\xEDes de ensayo aparecen movidos cada ma\xF1ana
    hacia la puerta del taller. He pedido a las alumnas que no entren sin luz.\u201D"
