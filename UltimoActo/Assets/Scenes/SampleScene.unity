  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n5_krol_gear_note
  title: "Nota del Maestro Krol \u2014 El Mecanismo del Reloj"
  subtitle: Directora de la Academia (1974)
  content: "Escondida tras el proyector:\n\n\xABEl reloj se detuvo a las 20:15 por
    una cu\xF1a de hierro, pero nadie recuerda qui\xE9n la puso.\nSi quieres que
    el engranaje vuelva a girar sin romperse, lib\xE9ralo en este orden: primero
    el P\xC9NDULO, luego los MINUTOS y al final las HORAS.\nHazlo en la torre. Yo
    ya no tengo edad para subir.\xBB"
