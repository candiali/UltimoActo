  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s1_elena_substitution_record
  title: "Expediente Reservado \u2014 Orden de Sustituci\xF3n del Acto III"
  subtitle: Directora de la Academia (1974)
  content: "DIRECCI\xD3N DE LA ACADEMIA \u2014 14 DE OCTUBRE DE 1924 (18:30 H)\n\n\xABQueda
    resuelto que Mara Bell bailar\xE1 el solo del Cisne Negro en sustituci\xF3n de
    Elena Vesper.\nElena ser\xE1 conducida a la Enfermer\xEDa Antigua y no se le
    permitir\xE1 abandonar el recinto hasta que concluya la temporada.\n\n\u2014
    Isadora Vale\xBB"
