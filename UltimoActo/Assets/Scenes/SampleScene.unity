  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_clue_scenery_b00
  title: "Marca de los Carpinteros en el Muro Oeste del Almac\xE9n"
  subtitle: Directora de la Academia (1974)
  content: "ALMAC\xC9N DE DECORADOS \u2014 ANOTACI\xD3N TRAS EL BASTIDOR OESTE\n\n\xABDetr\xE1s
    de este muro oeste (`X = 10.6m`) existe un vano hueco de cuatro metros y medio
    que nos prohibieron abrir desde el almac\xE9n. Su \xFAnica entrada baja desde
    el **panel m\xF3vil del descansillo este del escenario (`X = 10, Z = 116`)**
    y vuelve a subir hasta una c\xE1mara privada pegada al escenario principal\xBB."
