  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_vestibule_registry
  title: "Libro de Hu\xE9spedes \u2014 \xDAltimo Ensayo General"
  subtitle: Directora de la Academia (1974)
  content: "14 de Octubre de 1924\n\nEl ensayo final de 'El Lago de los Cisnes' dar\xE1
    comienzo a las 20:00 h en el Gran Teatro.\nElena Vesper (Cisne Negro) ha manifestado
    malestar y se niega a ensayar con el resto del elenco.\nSe escucharon gritos
    cerca de la sala de espejos antes del cierre.\n\n[Una nota apresurada a\xF1adida
    al pie con tinta corrida]:\n\u201CLa m\xFAsica se detuvo. Elena no est\xE1 en
    su camerino. Las puertas del teatro han sido cerradas con llave desde adentro.\u201D"
