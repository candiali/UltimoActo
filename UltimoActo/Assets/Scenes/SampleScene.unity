  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_forbidden_3_contradiction
  title: "3. Parte M\xE9dico Interno \u2014 Contradicci\xF3n con el Acta Oficial
    (14 de Octubre, 20:30 h)"
  subtitle: Directora de la Academia (1974)
  content: "ARCHIVO PROHIBIDO \u2014 CARPETA III (REGISTRO NO ENTREGADO A LA POLIC\xCDA)\n\n\xAB20:30
    h del 14 de octubre de 1924: Contrariamente al comunicado redactado para las
    autoridades donde se afirma que Elena Vesper huy\xF3 del teatro durante la funci\xF3n,
    la alumna fue atendida por contusiones leves tras la ca\xEDda del bastidor de
    contrapeso y trasladada bajo llave al ala privada de direcci\xF3n\xBB."
