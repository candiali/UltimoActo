MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1326609775}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s6_elena_folded_score
  title: Partitura Doblada con Anotaciones de Escena y Tramoya
  subtitle: Directora de la Academia (1974)
  content: "Un pliego doblado en cuatro partes que combina el comp\xE1s 48 de la
    versi\xF3n original de \xABEl Lago de las Sombras\xBB con un esquema t\xE9cnico
    del escenario:\n\n\u2022 Contradicci\xF3n con Administraci\xF3n: Mientras el
    informe oficial afirma que Elena abandon\xF3 la academia antes de la funci\xF3n,
    esta hoja tiene anotaciones de \xFAltima hora hechas con l\xE1piz de camerino
    a las **20:10 h**.\n\u2022 Nota de Elena: \xABCuando el violonchelo toque el
    Do Natural de la partitura original, el Contrapeso III de la Sala de Poleas debe
    estar arriba para mantener abierto el paso central del decorado del lago\xBB.\n\nExamina
    tambi\xE9n el **Vestuario del Cisne Negro ([E])** en el centro del camerino para
    reconstruir sus preparativos."
