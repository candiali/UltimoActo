  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s6_backstage_callsheet
  title: "Tabl\xF3n de Regidur\xEDa \u2014 Orden de Escena de la \xDAltima Representaci\xF3n"
  subtitle: Directora de la Academia (1974)
  content: "PASILLO DETR\xC1S DEL ESCENARIO \u2014 GU\xCDA DE CONEXIONES Y REGISTRO
    DE FUNCI\xD3N\n\n\u2022 Al Este (\u2192): Camerino de Mara (Zona 26), Camerino
    de Elena (Zona 27), retorno al Dep\xF3sito de Instrumentos y Puerta de Servicio
    Exterior.\n\u2022 Al Norte-Centro (\u2191): Almac\xE9n de Decorados (Zona 29)
    y Puertas de Acceso al Escenario Principal.\n\u2022 Al Oeste (\u2190): Sala de
    Mecanismos y Poleas (Zona 30).\n\nAnotaci\xF3n del regidor de escena (14 de Octubre,
    20:14 h):\n\xABAlguien ha echado el cierre mec\xE1nico de las puertas del Escenario
    Principal desde la Sala de Mecanismos y Poleas. Para abrir el paso al escenario
    hay que liberar el Contrapeso III en la Sala de Poleas\xBB."
