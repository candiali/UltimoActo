  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_clue_admin_b00
  title: "Memor\xE1ndum Reservado \u2014 Traslado al Dep\xF3sito Subterr\xE1neo B-00"
  subtitle: Directora de la Academia (1974)
  content: "DIRECCI\xD3N GENERAL \u2014 NOTA DE ARCHIVO INTERNO (17 DE OCTUBRE DE
    1924)\n\n\xABPor orden de Isadora Vale, toda la correspondencia privada del Patronato
    y el acta m\xE9dica real de la noche del 14 de octubre han sido retiradas de
    este archivo administrativo y depositadas bajo llave en la **B\xF3veda Estructural
    B-00**, cuyo acceso se oculta tras el panel de caoba del hombro este del Escenario
    Principal\xBB."
