  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s7_auditorium_ticket_stub
  title: "Entrada de Palco y Anotaci\xF3n de un Testigo entre las Butacas"
  subtitle: Directora de la Academia (1974)
  content: "FILA 4, BUTACA 12 \u2014 14 DE OCTUBRE DE 1924 (20:00 H)\n\nEn el reverso
    de la entrada alguien escribi\xF3 con l\xE1piz apresurado antes de desalojar
    la sala:\n\xABEn mitad del tercer acto, la m\xFAsica del foso toc\xF3 un acorde
    discordante y los focos de la Cabina de Iluminaci\xF3n apagaron de golpe el fondo
    del escenario. Escuchamos un golpe seco de contrapesos detr\xE1s del tel\xF3n
    intermedio y un grito ahogado, pero el director oblig\xF3 a la orquesta a tocar
    m\xE1s fuerte mientras sal\xEDa la segunda bailarina\xBB"
