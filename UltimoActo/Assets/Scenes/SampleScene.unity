  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_contradictory_instrument_tags
  title: "Etiquetas de Inventario de Instrumentos \u2014 Fechas Contradictorias"
  subtitle: Directora de la Academia (1974)
  content: "ETIQUETAS DE DEP\xD3SITO ORQUESTAL \u2014 ACADEMIA VESPER\n\n\u2022 Estuches
    de Viol\xEDn I\u2013IV: \xABRetirados del foso de orquesta el 18 de octubre tras
    la clausura oficial\xBB.\n\u2022 Violonchelo Solista (Cubierto con lona negra):
    \xABRetirado por orden directa de Isadora Vale el 13 DE OCTUBRE DE 1924\xBB.\n\n\xA1CONTRADICCI\xD3N!:
    Seg\xFAn los registros oficiales, el ensayo general con orquesta completa iba
    a celebrarse la noche del 14 de octubre. Sin embargo, el violonchelo principal
    que daba la se\xF1al de entrada a Elena ya hab\xEDa sido confiscado y escondido
    aqu\xED el d\xEDa anterior."
