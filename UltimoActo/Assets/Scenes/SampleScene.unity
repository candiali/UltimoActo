  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_mirror_back_note
  title: "Nota Oculta en el Reverso del Espejo de Elena (Tocador N\xBA 3)"
  subtitle: Directora de la Academia (1974)
  content: "Escrito con l\xE1piz de ojos negro en la madera trasera del marco ovalado:\n\n\u201C13
    de Octubre \u2014 Anoche las bombillas del tocador parpadearon y mi reflejo tard\xF3
    un segundo m\xE1s que yo en bajar los brazos.\n\nHe cerrado con llave mi habitaci\xF3n
    privada al fondo del corredor norte. Guard\xE9 la llave dentro de mi taquilla
    personal (Taquilla N\xBA 14, en la sala de taquillas junto al vestuario) para
    que ni Mara ni la Directora puedan registrar mis cuadernos.\u201D"
