MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 122451879}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_theory_and_versions
  title: "Tratado de Armon\xEDa Esc\xE9nica y Registro de Modificaciones"
  subtitle: Directora de la Academia (1974)
  content: "Entre las p\xE1ginas de un tratado de teor\xEDa musical aparece una ficha
    comparativa de pu\xF1o y letra de Elena Vesper:\n\n\u201CIsadora cree que nadie
    nota por qu\xE9 cambi\xF3 los \xFAltimos diecis\xE9is compases de 'El Lago de
    las Sombras'.\nEn la versi\xF3n original, la solista permanece en el centro del
    proscenio mientras sube la luz. En la versi\xF3n modificada por Vale el 12 de
    octubre, la m\xFAsica introduce un acorde falso para dar entrada a una segunda
    bailarina desde la sombra y apagar las candilejas.\u201D"
