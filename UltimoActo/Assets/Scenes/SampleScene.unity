  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_service_transfer_log
  title: "Albar\xE1n de Traslado Interno \u2014 Personal de Tramoya y Servicio"
  subtitle: Directora de la Academia (1974)
  content: "REGISTRO DE MOVIMIENTO DE MATERIAL ESC\xC9NICO (17 DE OCTUBRE, 21:30
    H)\n\n\u2022 Ba\xFAl N\xBA 04 (Partituras originales de 'El Lago de las Sombras'):
    Trasladado al Archivo Musical y cerrado con llave.\n\u2022 Atrezo del Tercer
    Acto: Retirado del escenario principal hacia la Zona T\xE9cnica del Teatro.\n\nNota
    del encargado de turno:\n\u201CNos ordenaron despejar el aula principal antes
    de las diez. Cuando pasamos con los carros frente a la Sala Auxiliar de Repetici\xF3n,
    el piano de adentro segu\xEDa sonando a pesar de que la puerta llevaba cerrada
    con candado desde el mediod\xEDa.\u201D"
