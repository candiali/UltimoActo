--- !u!114 &469253625
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 469253623}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_entrance_edict_1924
  title: Edicto Oficial de Clausura (Octubre 1924)
  subtitle: Directora de la Academia (1974)
  content: "ACADEMIA IMPERIAL DE BALLET\n\nPor disposici\xF3n gubernamental y de
    la Direcci\xF3n art\xEDstica de Isadora Vale, este edificio queda CLAUSURADO
    indefinidamente tras la desaparici\xF3n de la primera bailarina Elena Vesper
    durante el ensayo general de 'El Lago de las Sombras'.\n\nQueda prohibido el
    paso a prensa y curiosos.\n\nTodo el archivo documental, libros de registro y
    expedientes de las alumnas han quedado bajo custodia en el ala de ADMINISTRACI\xD3N
    (ala oeste del vest\xEDbulo).\n\nLos investigadores autorizados deben registrar
    su ingreso en la recepci\xF3n antes de continuar la inspecci\xF3n."
