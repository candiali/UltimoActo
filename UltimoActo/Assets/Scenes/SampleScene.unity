  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_empty_original_ending_folder
  title: "Carpeta Vac\xEDa \u2014 \xABFinal Original de la Composici\xF3n (Octubre
    1922)\xBB"
  subtitle: Directora de la Academia (1974)
  content: "CARPETA ARCHIVADORA N\xBA 01 \u2014 SELLO DE DIRECCI\xD3N\n\nLa carpeta
    que deber\xEDa contener el manuscrito \xEDntegro del desenlace original de \xABEl
    Lago de las Sombras\xBB est\xE1 completamente vac\xEDa.\nEn la solapa interior
    solo queda el rastro de lacre roto y un recibo de retirada firmado el 14 de octubre
    a las 19:40 h.\n\nUsa la Mesa Central de Clasificaci\xF3n ([E]) para ordenar
    cronol\xF3gicamente los borradores restantes y reconstruir la secci\xF3n arrancada."
