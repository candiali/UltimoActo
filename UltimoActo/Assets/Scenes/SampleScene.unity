  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_student_list
  title: Lista Oficial de Alumnas y Taquillas (Octubre de 1924)
  subtitle: Directora de la Academia (1974)
  content: "REGISTRO INTERNO DE VESTUARIO \u2014 ACADEMIA VESPER\n\n\u2022 Taquilla
    N\xBA 03 \u2014 Sof\xEDa Lindqvist (Cuerpo de baile)\n\u2022 Taquilla N\xBA 07
    \u2014 Mara Bell (Primera Suplente)\n\u2022 Taquilla N\xBA 11 \u2014 Clara Valmont
    (Corifeo)\n\u2022 Taquilla N\xBA 14 \u2014 Elena Vesper (Primera Bailarina \u2014
    Cisne Negro)\n\nNota de la Gobernanta:\n\u201CSe recuerda a las alumnas que las
    llaves de las habitaciones privadas del ala norte son responsabilidad exclusiva
    de cada solista.\u201D"
