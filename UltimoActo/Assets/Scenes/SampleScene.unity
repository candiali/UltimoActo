  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n3_boarders_diary
  title: Diario Colectivo de las Internas
  subtitle: Directora de la Academia (1974)
  content: "Bajo la almohada de la cama N.\xBA 1, escrito por turnos por varias manos:\n\n\xABIsadora
    nos escucha por las celos\xEDas. Por eso hablamos de tinte y no de nombres.\nSi
    quieres saber qu\xE9 le dieron a Elena, busca la receta del Cisne Negro en el
    banco del zapatero: primero el azabache, luego el carm\xEDn, al final la plata.\xBB"
