  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s6_scenery_contradictory_label
  title: "Registro de Almac\xE9n Escenogr\xE1fico \u2014 Contradicci\xF3n de Fechas"
  subtitle: Directora de la Academia (1974)
  content: "INVENTARIO DE ESCENOGRAF\xCDA \u2014 \xABEL LAGO DE LAS SOMBRAS\xBB\n\n\u2022
    Registro Oficial de Direcci\xF3n: \xABEl decorado original del Lago Nocturno
    con arco central permaneci\xF3 montado hasta la clausura del 18 de octubre\xBB.\n\u2022
    Etiqueta f\xEDsica clavada en la caja de utiler\xEDa N\xBA 09: **\xABRetirado
    del escenario principal la noche del 13 de octubre de 1924 por orden directa
    de Isadora Vale\xBB**.\n\nInspecciona el gran **Panel del Lago Nocturno al fondo
    del almac\xE9n ([E])** para comparar su estructura con las fotograf\xEDas oficiales."
