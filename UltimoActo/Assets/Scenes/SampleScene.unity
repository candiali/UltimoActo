  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_incomplete_attendance
  title: "Lista de Asistencia Incompleta \u2014 Ensayo Nocturno"
  subtitle: Directora de la Academia (1974)
  content: "CONTROL DE ASISTENCIA OBLIGATORIA \u2014 SALA PRINCIPAL\n\n1. Sof\xEDa
    Lindqvist \u2014 Presente\n2. Clara Valmont \u2014 Presente\n3. Mara Bell \u2014
    Presente (Asignada al puesto central por orden de Direcci\xF3n)\n4. Elena Vesper
    \u2014 [Casilla en blanco, tachada con trazo tembloroso]\n\nObservaciones:\n\u201CAunque
    Elena no firm\xF3 la hoja de entrada a las 19:00 h, sus zapatillas de ensayo
    y su partitura anotada ya estaban colocadas frente al espejo antes de que abri\xE9ramos
    el aula.\u201D"
