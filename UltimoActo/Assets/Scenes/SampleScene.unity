--- !u!114 &525540715
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 525540713}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s6_elena_torn_diary_pages
  title: "P\xE1ginas Arrancadas del Diario de Elena Vesper (14 de Octubre)"
  subtitle: Directora de la Academia (1974)
  content: "\u201CSi alguien encuentra estas p\xE1ginas en mi camerino es porque
    no me dejaron terminar el \xFAltimo acto.\n\nIsadora retir\xF3 ayer el decorado
    original al Almac\xE9n de Decorados y orden\xF3 modificar las cuerdas de la Sala
    de Mecanismos y Poleas. No quiere sustituirme \xFAnicamente en el cartel: quiere
    que el tel\xF3n de contrapeso caiga antes de que yo pueda cruzar hacia el proscenio.\n\nHe
    dejado la prueba cosida dentro del traje del Cisne Negro.\u201D"
