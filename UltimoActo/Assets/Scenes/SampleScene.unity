MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1855303466}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s10_infirmary_student_files
  title: "Fichas Cl\xEDnicas de Alumnas \u2014 Temporada de Oto\xF1o de 1924"
  subtitle: Directora de la Academia (1974)
  content: "EXTRACTO DEL ARCHIVO M\xC9DICO DE LA ACADEMIA\n\n\u2022 **Mara Bell (08
    Oct. 1924)**: \xABInflamaci\xF3n severa en ambos tendones de Aquiles por exceso
    de repeticiones de la variaci\xF3n del Cisne Negro. La alumna confiesa entre
    l\xE1grimas que la Directora la obliga a ensayar a medianoche para sustituir
    a Elena.\xBB\n\u2022 **Clara Valmont (11 Oct. 1924)**: \xABInsomnio y episodios
    de p\xE1nico; afirma haber o\xEDdo voces discutidas bajo el suelo del escenario
    principal.\xBB"
