  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n3_isadora_private_diary
  title: Diario Privado de Isadora Vale
  subtitle: Directora de la Academia (1974)
  content: "Del compartimento del aparador:\n\n\xABElena no iba a denunciar mi negligencia:
    iba a denunciar lo que hice despu\xE9s. Si la sustituyo, el teatro la olvida.\nHe
    mandado cerrar las alas una a una. Que la academia misma decida a qui\xE9n deja
    pasar.\xBB\n\nUna anotaci\xF3n posterior, con otra letra: \xABLas puertas se
    abren solas cada noche, un poco m\xE1s.\xBB"
