  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_clue_pulleys_b00
  title: "Anexo Estructural \u2014 Plano del Muro Este y Escalera Oculta (B-00)"
  subtitle: Directora de la Academia (1974)
  content: "SALA DE MECANISMOS \u2014 PLANO DE CIMIENTOS DEL TEATRO\n\nEl plano de
    cimentaci\xF3n muestra una galer\xEDa subterr\xE1nea bajo el ala noreste del
    teatro:\n\u2022 **Acceso Oculto (`B-00`)**: En el descansillo este entre el Escenario
    Principal y el Patio de Butacas (`X = 10m, Z = 116m`), un panel de moldura cl\xE1sica
    se desliza al presionarlo (`[E]`), revelando la **Escalera Oculta (Zona 36)**."
