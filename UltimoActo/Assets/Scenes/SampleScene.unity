--- !u!114 &287683184
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 287683182}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s1_seasons_portrait_clue
  title: "Programa Lit\xFArgico de las Cuatro Prima Donnas"
  subtitle: Directora de la Academia (1974)
  content: "ANOTACI\xD3N HIST\xD3RICA DEL MAESTRO DE BAILE:\n\n\xABA cada primera
    bailarina le corresponde la corona de una estaci\xF3n:\n\u2022 Beatrice Dupont
    danz\xF3 bajo la nieve helada del Invierno [IV].\n\u2022 Clara Henschel floreci\xF3
    con el despertar de la Primavera [I].\n\u2022 Teresa Vane rein\xF3 en las hojas
    ca\xEDdas del Oto\xF1o [III].\n\u2022 Elena Vesper recibi\xF3 los laureles en
    la noche estival del Solsticio de Verano [II].\n\nLos diales del pasillo honran
    este ciclo antes de que cualquier alumna pueda entrar al Aula de Ensayo.\xBB"
