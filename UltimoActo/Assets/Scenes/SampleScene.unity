  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n4_fountain_ledger
  title: "Papel Impermeabilizado del Fondo de la Fuente \u2014 Orden de los Sectores"
  subtitle: Directora de la Academia (1974)
  content: "Pegado bajo el brocal, protegido con cera:\n\n\xABSi buscas por qu\xE9
    se apag\xF3 el teatro la noche del 14, ve al s\xF3tano de mantenimiento y reconecta
    los sectores como se hac\xEDa tras un apag\xF3n: primero el AGUA, luego la CALEFACCI\xD3N,
    despu\xE9s la ILUMINACI\xD3N y por \xFAltimo el TEATRO.\nAs\xED lo registr\xF3
    el ingeniero. As\xED debe volver a quedar.\xBB"
