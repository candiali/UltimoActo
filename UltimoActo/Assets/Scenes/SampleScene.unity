  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n2_dosage_card
  title: "Ficha de Dosificaci\xF3n Nocturna (Enfermera Hale)"
  subtitle: Directora de la Academia (1974)
  content: "PROTOCOLO PARA LA PACIENTE DEL ACTO III:\n\n\xABPrimero calmar el pulso:
    VALERIANA.\nDespu\xE9s dormir el dolor: L\xC1UDANO.\nAl final, sedar del todo:
    CLORAL.\n\nNunca alterar el orden. La Directora lo comprueba cada ma\xF1ana en
    la botica de la sala de camillas.\xBB"
