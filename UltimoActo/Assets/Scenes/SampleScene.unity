MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2042942079}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n4_restoration_note
  title: "Nota del Archivero \u2014 C\xF3mo se Restaura una Obra Alterada"
  subtitle: Directora de la Academia (1974)
  content: "\xABPara deshacer una falsificaci\xF3n hay que desandarla: se empieza
    por la versi\xF3n m\xE1s reciente, la oficial de octubre de 1924, se sigue con
    la revisi\xF3n de septiembre y se termina en el manuscrito original de 1922.\nLos
    tres vol\xFAmenes est\xE1n sobre la mesa de restauraci\xF3n. Col\xF3calos en
    ese orden y la estanter\xEDa devolver\xE1 lo que escondi\xF3.\xBB"
