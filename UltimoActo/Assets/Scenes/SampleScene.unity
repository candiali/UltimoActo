  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_reception_log_1924
  title: "Libro Diario de Recepci\xF3n \u2014 12 de Octubre de 1924"
  subtitle: Directora de la Academia (1974)
  content: "Directora Vale orden\xF3 prohibir el paso a extra\xF1os despu\xE9s de
    las 18:00 h.\n\nAnotaci\xF3n manuscrita del recepcionista:\n\u201CElena Vesper
    insiste en que las sombras en el escenario no siguen su movimiento.\nSe niega
    a devolver la llave maestra del s\xF3tano y asegura que el \xFAltimo ensayo general
    no terminar\xE1 nunca.\u201D"
