  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_photo_note
  title: "Folleto de la Academia \u2014 Temporada 1923"
  subtitle: Directora de la Academia (1974)
  content: "Folleto publicitario de la prestigiosa Academia Vesper.\n\nAl examinar
    la fotograf\xEDa enmarcada en la pared:\nEn la primera fila del cuerpo de baile
    se observa un espacio inexplicable entre dos alumnas sonrientes, con una sombra
    distorsionada sobre las tablas del escenario.\n\nAlguien ha rayado furiosamente
    uno de los nombres del pie de foto con un alfiler."
