  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_ballet_slippers
  title: Zapatillas de Punta con Nombre Escrito a Mano
  subtitle: Directora de la Academia (1974)
  content: "Un par de zapatillas de sat\xE9n rosa desgastadas por el uso intenso.
    En la suela de cuero aparece escrito a mano con tinta negra:\n\xABElena Vesper
    \u2014 Solista Principal\xBB.\n\nLas cintas de sujeci\xF3n no se desataron: fueron
    cortadas limpiamente con tijeras.\nDentro de la puntera izquierda hay un trozo
    de papel doblado: \xABMara volvi\xF3 a registrar mi bolso durante el descanso.
    He tenido que esconder mis cosas importantes bajo llave.\xBB"
