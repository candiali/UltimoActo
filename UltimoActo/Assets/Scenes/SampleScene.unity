  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_forbidden_6_incomplete_dossier
  title: "6. Expediente Especial N\xBA 00 \u2014 [FALTA LA \xDALTIMA P\xC1GINA]"
  subtitle: Directora de la Academia (1974)
  content: "ARCHIVO PROHIBIDO \u2014 EXPEDIENTE N\xBA 00 (17 DE OCTUBRE DE 1924)\n\nLa
    \xFAltima p\xE1gina del expediente ha sido arrancada del broche met\xE1lico.
    En el margen inferior queda una l\xEDnea escrita:\n\xABLa \xFAltima p\xE1gina
    de este expediente, junto con la fotograf\xEDa real de la funci\xF3n y la partitura
    a dos manos, permanece en la **C\xE1mara tras el Escenario (Zona 39)**.\nInteract\xFAa
    con la **Mesa Central ([E])** para ordenar los 6 registros cronol\xF3gicamente
    y desbloquear la puerta oeste\xBB."
