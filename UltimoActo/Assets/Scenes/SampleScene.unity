MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1462506529}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_elena_incomplete_letter
  title: "Carta Incompleta de Elena Vesper \u2014 [REVELACI\xD3N PRINCIPAL]"
  subtitle: Directora de la Academia (1974)
  content: "Manuscrito con fecha del 16 DE OCTUBRE DE 1924 (dos d\xEDas DESPU\xC9S
    de su supuesta desaparici\xF3n oficial el 14 de octubre):\n\n\u201CQuerida hermana:\nSi
    alg\xFAn d\xEDa logras leer esto, no creas ni una palabra de lo que Isadora Vale
    escribi\xF3 en el libro de recepci\xF3n. Anotaron que desaparec\xED durante el
    ensayo general de la noche del 14 de octubre, pero hoy es 16 de octubre y sigo
    aqu\xED.\n\nMe encerraron en el ala privada despu\xE9s de que descubriera lo
    que ocurri\xF3 realmente tras el tel\xF3n del teatro. La cronolog\xEDa oficial
    es una farsa para encubrir lo que pas\xF3 la noche del estreno.\u201D"
