  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_locker07_mara
  title: "Taquilla N\xBA 07 (Mara Bell) \u2014 Carta entre Alumnas"
  subtitle: Directora de la Academia (1974)
  content: "Una carta doblada escondida bajo unas cintas de ballet:\n\n\u201C12 de
    Octubre de 1924\nMara: La Directora Vale me confirm\xF3 hoy en su despacho que
    t\xFA bailar\xE1s el acto final el d\xEDa 14. Dijo que Elena \u2018no estar\xE1
    en condiciones de subir al escenario\u2019.\n\xBFC\xF3mo puede estar tan segura
    dos d\xEDas antes del estreno? Ten cuidado, lo que planean en direcci\xF3n no
    es una simple sustituci\xF3n.\u201D"
