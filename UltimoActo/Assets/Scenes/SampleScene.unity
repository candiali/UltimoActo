  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_last_performance_fragment
  title: "Fragmento de Papel \u2014 Referencia a la \xDAltima Representaci\xF3n"
  subtitle: Directora de la Academia (1974)
  content: "Un recorte arrancado de las instrucciones esc\xE9nicas para la noche
    del estreno de \xABEl Lago de las Sombras\xBB:\n\n\u201C...la Directora Vale
    ha ordenado que el vestuario original de Elena sea trasladado a la sala contigua
    de maniqu\xEDes antes del tercer acto.\nOficialmente se dir\xE1 que Elena abandon\xF3
    la academia por voluntad propia antes del ensayo general, pero su tut\xFA de
    escena a\xFAn conserva las agujas clavadas del ajuste de esta tarde.\u201D"
