  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_elena_mara_score_discrepancies
  title: Partituras Anotadas por Elena Vesper y Mara Bell (Comparativa)
  subtitle: Directora de la Academia (1974)
  content: "Dos ejemplares de ensayo colocados uno junto al otro muestran una contradicci\xF3n
    evidente:\n\n\u2022 En la partitura de Elena Vesper: las indicaciones de escena
    dicen \xABLa solista permanece sola junto al espejo central hasta el \xFAltimo
    acorde en Do Natural\xBB.\n\u2022 En la partitura de Mara Bell (fechada antes
    de la desaparici\xF3n de Elena): alguien escribi\xF3 con tinta de Direcci\xF3n
    \xABEn el comp\xE1s 48, cortar la luz del proscenio y cerrar el paso lateral
    antes de que termine la coda\xBB."
