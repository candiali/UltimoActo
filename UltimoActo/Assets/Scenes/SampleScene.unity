  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n2_mourning_book
  title: "Libro de Duelo \u2014 Orden de las Ofrendas"
  subtitle: Directora de la Academia (1974)
  content: "RITUAL DE LA SALA CONMEMORATIVA:\n\n\xABPrimero el laurel, por las que
    se graduaron.\nDespu\xE9s las rosas, por las solistas.\nAl final las flores negras,
    por las que nadie nombra.\xBB"
