  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s7_auditorium_handbill
  title: "Programa de Mano Antiguo \u2014 Gran Estreno del 14 de Octubre de 1924"
  subtitle: Directora de la Academia (1974)
  content: "GRAN TEATRO DE LA ACADEMIA VESPER \u2014 PROGRAMA OFICIAL\n\n\xABEL LAGO
    DE LAS SOMBRAS \u2014 Ballet en Tres Actos\xBB\n\u2022 Actos I y II (Primera
    Bailarina): **Elena Vesper**.\n\u2022 Acto III \u2014 El Cierre del Lago: Se
    observa una tira de papel impresa pegada a \xFAltima hora sobre el nombre de
    Elena con el nombre de **Mara Bell**.\n\nAl comparar este programa con las cintas
    del Archivo Musical, compruebas que el cambio de bailarina en el Acto III ya
    estaba impreso ANTES de que comenzara la funci\xF3n en la que supuestamente Elena
    desapareci\xF3 de forma imprevista."
