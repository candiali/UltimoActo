MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 941259000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_discreet_compartment_note
  title: Nota Guardada en el Compartimento Discreto de la Biblioteca
  subtitle: Directora de la Academia (1974)
  content: "\u201CAl archivero jefe:\n\nHe guardado las tres carpetas de ensayo en
    el Archivo de Partituras (puerta este) y las cintas magn\xE9ticas de la \xFAltima
    semana en la Cabina de Grabaciones.\nPor favor, si escuchas pasar p\xE1ginas
    en la estanter\xEDa del fondo cuando la biblioteca est\xE1 cerrada, no enciendas
    las luces altas: el aire que sube desde el foso de orquesta mueve los papeles...
    o eso prefiero creer.\u201D"
