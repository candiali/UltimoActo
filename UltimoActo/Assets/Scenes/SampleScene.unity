  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n2_erased_students_list
  title: Lista de Alumnas Borradas de la Sala de Honor
  subtitle: Directora de la Academia (1974)
  content: "Bajo el pedestal central, un compartimento se abre y deja ver una lista:\n\n\xABAlumnas
    retiradas de la memoria p\xFAblica por orden de Direcci\xF3n: C. Valmont (1919),
    N. Volkova (1921), M. Laurent (1922) y E. Vesper (1924).\nSus placas fueron arrancadas.
    Sus familias recibieron cartas de 'traslado voluntario'.\xBB"
