  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_maintenance_shortcut_note
  title: "Aviso para el Personal \u2014 Corredor Lateral hacia el Vest\xEDbulo"
  subtitle: Directora de la Academia (1974)
  content: "COMUNICACI\xD3N INTERNA DE MANTENIMIENTO\n\n\u201CEste corredor de servicio
    permanece habilitado como paso directo entre las Aulas de Ensayo del ala norte
    y la salida hacia el Vest\xEDbulo Principal.\n\nSe recuerda a los tramoyistas
    no dejar carros bloqueando las puertas dobles ni responder si escuchan m\xFAsica
    procedente de las salas clausuradas despu\xE9s del toque de queda.\u201D"
