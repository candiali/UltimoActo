  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s10_basement_pipe_acoustics
  title: "Nota T\xE9cnica \u2014 Transmisi\xF3n de Sonidos por los Conductos de Calefacci\xF3n"
  subtitle: Directora de la Academia (1974)
  content: "Anotaci\xF3n del operario de calderas:\n\n\xABLas tuber\xEDas de cobre
    que suben desde este muro oeste atraviesan directamente las aulas de ballet,
    la sala del piano y el foso del teatro.\nDe noche, cuando el edificio queda en
    silencio, basta con acercarse al colector para o\xEDr con total nitidez lo que
    ocurre arriba: pasos de ensayo sobre la madera, compases del piano y voces apagadas
    detr\xE1s de los muros.\xBB"
