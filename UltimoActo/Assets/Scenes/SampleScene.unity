  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_shower_forgotten_item
  title: "Medall\xF3n Oxidado y Rastro Reciente en la Cabina de Ducha N\xBA 3"
  subtitle: Directora de la Academia (1974)
  content: "Junto al desag\xFCe de la tercera cabina de ducha hay un medall\xF3n
    de lat\xF3n empa\xF1ado por la humedad y restos de barro seco que no pertenecen
    al suelo de parquet del vestuario.\n\nDentro del medall\xF3n se conserva una
    miniatura borrosa de Elena y una inscripci\xF3n:\n\xABQuien estuvo aqu\xED despu\xE9s
    de la clausura ven\xEDa desde los niveles inferiores buscando agua limpia.\xBB"
