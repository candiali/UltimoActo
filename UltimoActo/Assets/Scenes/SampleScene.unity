MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1878163141}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n5_clockmaker_record
  title: "Registro del Relojero \u2014 Orden de Encendido de las Calderas"
  subtitle: Directora de la Academia (1974)
  content: "Encontrado en un compartimento tras el cuadrante:\n\n\xABPor orden de
    la Directora, el reloj se detuvo a las 20:15 del 14 de octubre para que 'el tiempo
    no testifique'.\nPara reavivar el sistema de calefacci\xF3n que alimenta la torre
    hay que encender las calderas en este orden: primero la N.\xBA 2, luego la N.\xBA
    3 y por \xFAltimo la N.\xBA 1. La tres es la que quem\xF3 cosas que no deb\xEDa.\xBB"
