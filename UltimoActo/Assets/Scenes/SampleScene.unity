  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s11_dormitory_curfew_rules
  title: "Reglamento del Internado \u2014 Toque de Queda y Clausura Nocturna (1924)"
  subtitle: Directora de la Academia (1974)
  content: "REGLAMENTO DE CONVIVENCIA DEL INTERNADO:\n\n\xAB1. A las 21:30 horas
    se apagar\xE1n todas las l\xE1mparas del Dormitorio Com\xFAn y se cerrar\xE1n
    con llave las puertas hacia el Comedor y los Talleres.\n2. Ninguna interna podr\xE1
    abandonar su cama bajo pretexto de escuchar m\xFAsica o pasos procedentes del
    Teatro o de la Enfermer\xEDa.\n3. Toda conversaci\xF3n sobre alumnas dadas de
    baja o trasladadas ser\xE1 sancionada con reclusi\xF3n inmediata.\xBB"
