  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_grand_piano_incomplete_score
  title: Partitura Incompleta de 'El Lago de las Sombras' (Sobre el Piano de Cola)
  subtitle: Directora de la Academia (1974)
  content: "CODA DEL TERCER ACTO \u2014 EJEMPLAR DE REPETICI\xD3N\n\nSobre la madera
    del piano de cola descansa la partitura de ensayo con correcciones superpuestas
    en tinta roja y l\xE1piz negro.\n\nDonde la versi\xF3n oficial exige tocar un
    acorde cortante y bajar el tel\xF3n, una anotaci\xF3n manuscrita al pie indica:\n\xABEl
    final original nunca deb\xEDa interrumpirse as\xED. Si reproduces en el teclado
    la secuencia original anotada en el Cat\xE1logo de la Biblioteca (Mi - Sol -
    Si - Do Natural - Mi), el compartimento del atril se abrir\xE1\xBB"
