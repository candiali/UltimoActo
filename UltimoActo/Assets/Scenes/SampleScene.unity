  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_music_catalog
  title: "Cat\xE1logo General del Archivo Musical (1918\u20131924)"
  subtitle: Directora de la Academia (1974)
  content: "REGISTRO DE COMPOSICIONES ESC\xC9NICAS \u2014 ACADEMIA VESPER\n\n\u2022
    Ref. M-104 (Octubre 1922): \xABEl Lago de las Sombras \u2014 Versi\xF3n Original
    del Maestro K. Vesper\xBB.\n  Cadencia del Acto Final escrita en Mi menor pura:
    \xABMi - Sol - Si - Do Natural - Mi\xBB.\n\n\u2022 Ref. M-104/B (Septiembre 1924):
    \xAB Primera Revisi\xF3n por orden de Isadora Vale\xBB.\n  Se acorta el solo
    del Cisne Blanco.\n\n\u2022 Ref. M-104/C (12 de Octubre 1924): \xABVersi\xF3n
    Oficial de Estreno \u2014 Modificada por Isadora Vale\xBB.\n  Nota al margen
    del bibliotecario: \xABLa Directora orden\xF3 alterar la cuarta nota de la coda
    en el piano de cola y retirar la partitura original de 1922 al Archivo de Partituras.
    El atril del piano de cola solo se desbloquea al tocar la cadencia original de
    1922\xBB"
