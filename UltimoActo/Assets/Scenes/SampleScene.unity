  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n3_vigil_list
  title: "Lista de Vigilia Nocturna \u2014 Dormitorio Com\xFAn"
  subtitle: Directora de la Academia (1974)
  content: "REGISTRO DE LA INSPECTORA, OCTUBRE DE 1924:\n\n\xABRonda de las 23:00.
    Comprobar las almohadas en este orden exacto:\n  1.\xBA la cama N.\xBA 3 (la
    que llora por las noches),\n  2.\xBA la cama N.\xBA 5 (la que sabe demasiado),\n 
    3.\xBA la cama N.\xBA 1 (la que nunca duerme).\n\nQuien rompa el orden despierta
    a las dem\xE1s.\xBB"
