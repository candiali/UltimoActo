  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s6_tarp_structure_note
  title: "Nota T\xE9cnica sobre el Bastidor de Cierre"
  subtitle: Directora de la Academia (1974)
  content: "Sobre la caja contigua hay un croquis de los carpinteros de teatro:\n\n\xABNos
    hicieron construir un panel ciego id\xE9ntico al arco del lago pero sin salida
    trasera. Si alguien baja el Contrapeso III desde la Sala de Poleas en mitad de
    la funci\xF3n, la bailarina que est\xE9 en el fondo del escenario queda incomunicada
    de los bastidores\xBB."
