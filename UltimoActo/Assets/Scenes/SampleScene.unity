  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_clue_music_b00
  title: "Ficha de Expurgo Musical \u2014 C\xE1mara Oculta tras el Escenario"
  subtitle: Directora de la Academia (1974)
  content: "ARCHIVO MUSICAL \u2014 REGISTRO DE PARTITURAS RETIRADAS\n\n\xABEl manuscrito
    \xEDntegro a dos manos de *El Lago de las Sombras* (anotado conjuntamente por
    Elena Vesper y Mara Bell) no fue destruido: fue guardado en la **C\xE1mara tras
    el Escenario**, accesible \xFAnicamente descendiendo por la Escalera Oculta (`Ref.
    B-00`) situada en el lateral este del proscenio\xBB."
