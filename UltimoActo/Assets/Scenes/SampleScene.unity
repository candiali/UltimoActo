  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_elena_movement_sequence
  title: "Anotaci\xF3n Secreta de Elena \u2014 Secuencia de Pasos y Compases"
  subtitle: Directora de la Academia (1974)
  content: "Guardada en el interior del armario de pr\xE1ctica hay una tarjeta manuscrita
    por Elena Vesper:\n\n\xABSECUENCIA PERSONAL DE ENSAYO \u2014 COMPASES CLAVE:\nI.
    Primer Arabesque \u2014 4 tiempos\nII. Pirueta en Attitude \u2014 2 tiempos\nIII.
    Reverencia hacia el espejo \u2014 7 tiempos\n\nSi algo me ocurre durante el ensayo
    general en el escenario, buscad las partituras originales en el Archivo Musical
    entrando por el pasillo de servicio.\xBB"
