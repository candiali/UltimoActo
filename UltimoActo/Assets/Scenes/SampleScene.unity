  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s10_rooftop_courtyard_sketch
  title: "Cuaderno de Orientaci\xF3n en la Azotea \u2014 Vista sobre los Patios"
  subtitle: Directora de la Academia (1974)
  content: "Un cuaderno de dibujo olvidado sobre el banco que mira hacia el Patio
    de Entrada:\n\n\xABSubir a la terraza despu\xE9s de horas de ensayo era nuestra
    \xFAnica forma de respirar aire libre.\nDesde esta balaustrada este se domina
    todo el **Patio de Entrada** y, al fondo a la derecha, brilla la gran b\xF3veda
    acristalada del **Jard\xEDn de Invierno**.\nPero desde la semana del estreno
    nadie quiere acercarse a la balaustrada del norte: dicen que de madrugada se
    enciende una luz en una parte del tejado del teatro donde no deber\xEDa existir
    ninguna habitaci\xF3n.\xBB"
