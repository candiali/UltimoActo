  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_forbidden_5_elena_mara_bond
  title: "5. Declaraci\xF3n Conjunta de Elena Vesper y Mara Bell (Secreto entre Alumnas)"
  subtitle: Directora de la Academia (1974)
  content: "ARCHIVO PROHIBIDO \u2014 CARPETA V (CONFISCADA A MARA BELL)\n\n\xABNos
    hicieron fingir ante toda la academia que \xE9ramos enemigas para que la Directora
    Vale confiara en Mara el papel sustituto del tercer acto. Ese era nuestro plan
    desde el principio: mientras Isadora cre\xEDa encerrar a Elena, Mara ten\xEDa
    preparada la salida oculta detr\xE1s del escenario\xBB."
