MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1011659739}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s5_missing_recording_note_discovery
  title: "Diapas\xF3n de Concierto y Partitura del Violonchelo Cubierto"
  subtitle: Directora de la Academia (1974)
  content: "Prendido bajo la tela oscura que cubre el violonchelo hay un diapas\xF3n
    de acero calibrado y una hoja de anotaciones:\n\n\xABComp\xE1s Final \u2014 Nota
    de Resoluci\xF3n: DO NATURAL (130.8 Hz)\xBB.\n\nAl escuchar la nota profunda
    que resuena desde este rinc\xF3n del dep\xF3sito cuando parpadea la l\xE1mpara,
    compruebas que coincide exactamente con la nota que faltaba en la grabaci\xF3n
    de la Cabina de Grabaciones.\n\nAl dorso se lee: \xABCon la cadencia completa
    reconstruida (Mi - Sol - Si - Do Natural - Mi), el mecanismo ac\xFAstico de la
    Zona T\xE9cnica del Escenario responder\xE1 cuando lleguemos al Gran Teatro.
    Las puertas oeste y sur de este dep\xF3sito conducen directamente de regreso
    a los Camerinos y Taquillas\xBB"
