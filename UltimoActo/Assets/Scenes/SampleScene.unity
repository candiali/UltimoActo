MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 703314052}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s8_forbidden_1_correspondence
  title: "1. Correspondencia Privada de la Direcci\xF3n (28 de Septiembre de 1924)"
  subtitle: Directora de la Academia (1974)
  content: "ARCHIVO PROHIBIDO \u2014 CARPETA I (CORRESPONDENCIA RESERVADA)\n\nCarta
    del Presidente del Patronato a la Directora Isadora Vale:\n\xABSi Elena Vesper
    cumple su amenaza de entregar a la prensa las cartas de su hermana fallecida
    en 1922, la Academia cerrar\xE1 y seremos procesados. Debe usted impedir que
    Elena abandone el edificio tras la gala del 14 de octubre, cueste lo que cueste\xBB."
