  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n5_boiler_manifest
  title: "Manifiesto de Carga \u2014 Cenicero N.\xBA 3 (15 de octubre)"
  subtitle: Directora de la Academia (1974)
  content: "Se abre una trampilla de carb\xF3n con un manifiesto dentro:\n\n\xABQuemado
    en la caldera N.\xBA 3: un tut\xFA negro, cintas de sat\xE9n manchadas y frascos
    de sedante vac\xEDos. Ordenado por Direcci\xF3n.\nLos fundadores del siglo XVIII
    dec\xEDan que la cripta solo se abre a quien honra los elementos en el orden
    de la piedra: primero la PIEDRA, luego el AGUA y al final el FUEGO.\xBB"
