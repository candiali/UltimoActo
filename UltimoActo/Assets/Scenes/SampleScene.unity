MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1860943150}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s6_mara_rehearsal_notes
  title: "Fotograf\xEDas Antiguas y Notas de Ensayo de Mara Bell"
  subtitle: Directora de la Academia (1974)
  content: "Sobre el tocador descansan horquillas, polveras y una fotograf\xEDa de
    1922 donde Elena y Mara posan abrazadas tras su primer recital juntas.\n\nJunto
    a la foto hay una libreta de ensayo abierta el 14 de octubre a las 19:50 h:\n\xABEscuch\xE9
    a Elena discutir con el t\xE9cnico de sonido y despu\xE9s encerrarse en su camerino
    (al lado del m\xEDo) con el traje del Cisne Negro. Dijo que hab\xEDa descubierto
    lo que ocultaban en el Almac\xE9n de Decorados y que iba a usar la m\xFAsica
    original para desenmascarar a Isadora en pleno escenario\xBB."
