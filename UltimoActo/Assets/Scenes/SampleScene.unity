  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s4_contradictory_garment
  title: "Corpi\xF1o Esc\xE9nico Oculto tras el Biombo (Contradicci\xF3n de Registros)"
  subtitle: Directora de la Academia (1974)
  content: "Oculto detr\xE1s del biombo de esquina se encuentra el corpi\xF1o original
    del Cisne Negro confeccionado a la medida exacta de Elena Vesper.\n\nLa etiqueta
    interior con el nombre \xABELENA VESPER\xBB fue arrancada a tirones y sobre ella
    se cosi\xF3 con hilo negro una etiqueta nueva: \xABMARA BELL \u2014 ESTRENO 15
    DE OCTUBRE\xBB.\n\n\xA1Esto contradice directamente el registro oficial de la
    Directora Vale, que aseguraba que el cambio de reparto solo se decidi\xF3 tras
    la desaparici\xF3n de Elena el 17 de octubre! El reemplazo ya estaba preparado
    d\xEDas antes."
