  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s3_incomplete_score
  title: "Partitura Incompleta \u2014 Fragmento del Archivo Musical"
  subtitle: Directora de la Academia (1974)
  content: "Una hoja de pentagrama arrancada con varias notas tachadas violentamente:\n\n\xABCoda
    en Mi Menor \u2014 Variaci\xF3n del Espejo: Mi - Sol - Si - Do# - Re\xBB\n\nNota
    al margen de Elena:\n\u201CEl maestro de orquesta arranc\xF3 la segunda mitad
    de esta partitura y la encerr\xF3 en el Archivo Musical del pasillo principal.
    Cuando tocan esos compases en el piano del ensayo, las luces del teatro responden.\u201D"
