  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s11_refectory_weighing_regime
  title: "Tabl\xF3n del Refectorio \u2014 R\xE9gimen Estricto y Control de Peso (Octubre
    1924)"
  subtitle: Directora de la Academia (1974)
  content: "ORDEN DE LA DIRECCI\xD3N \u2014 R\xC9GIMEN DE INTERNAS PREVIO AL ESTRENO:\n\n\xABQueda
    terminantemente prohibido servir pan, l\xE1cteos o caldo con grasa a las integrantes
    del cuerpo de baile durante las dos semanas previas a 'El Lago de las Sombras'.\n\nToda
    alumna cuyo peso exceda en m\xE1s de trescientos gramos el baremo fijado por
    Madame Vale ser\xE1 trasladada a vigilancia m\xE9dica en la Enfermer\xEDa Antigua
    y perder\xE1 su puesto en la fila principal.\xBB"
