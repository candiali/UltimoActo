  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n2_real_clinical_record
  title: "Registro Cl\xEDnico Real \u2014 Elena Vesper (13 de octubre de 1924)"
  subtitle: Directora de la Academia (1974)
  content: "ENFERMER\xCDA \u2014 ENTRADA RESERVADA:\n\n\xABPaciente: E. Vesper. Diagn\xF3stico
    oficial: agotamiento nervioso.\nDiagn\xF3stico real: ninguno. Se administra Valeriana,
    L\xE1udano y Cloral por orden de Direcci\xF3n para mantenerla d\xF3cil durante
    los ensayos.\n\nNota al margen: la paciente pregunta cada noche por qu\xE9 la
    dejan sin ver a su hermana.\xBB"
