  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_n5_founders_charter
  title: "Acta Fundacional de 1768 \u2014 Sobre qu\xE9 se Construy\xF3 la Academia"
  subtitle: Directora de la Academia (1974)
  content: "El altar cede una trampilla con un pergamino:\n\n\xABEn el a\xF1o de
    1768, sobre los cimientos de un antiguo teatro de maquinaria que ardi\xF3 con
    su compa\xF1\xEDa dentro, se fund\xF3 esta casa. El foso qued\xF3 sellado. Prometimos
    no volver a abrirlo.\xBB\n\nAl margen, escrito recientemente en carm\xEDn: \xABElena
    sab\xEDa que el foso volv\xEDa a respirar.\xBB"
