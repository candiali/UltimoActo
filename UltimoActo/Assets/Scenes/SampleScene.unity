  m_Script: {fileID: 11500000, guid: 13d6af3e5035b0e40a38d87b7d791469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimoActo.Narrative.WorldDocument
  id: doc_s7_stage_elena_mara_positions
  title: "Anotaci\xF3n de Regidur\xEDa sobre las Marcas del Suelo"
  subtitle: Directora de la Academia (1974)
  content: "Junto a las marcas de tiza y lat\xF3n del lateral derecho hay un par
    de cintas de raso cortadas:\n\n\xABPosici\xF3n A (Centro): Elena Vesper \u2014
    Coda original.\nPosici\xF3n B (Hombro Derecho): Mara Bell \u2014 Entrada a\xF1adida
    el 13 de octubre.\nPosici\xF3n C (Bajo el Arco del Lago): Punto donde Elena deb\xEDa
    emerger al sonar el Do Natural, justo debajo del bastidor conectado al Contrapeso
    III\xBB."
