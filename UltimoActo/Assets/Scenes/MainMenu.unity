  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>PREMISA</b>\nDos investigadores reciben una invitaci\xF3n a la abandonada
    Academia del Cisne.\nNing\xFAn jugador posee habilidades exclusivas. La verdad
    se descubre compartiendo pistas y coordinando mecanismos.\n\n<b>CONTROLES DE
    EXPLORACI\xD3N</b>\n\u2022 <color=#D8B468>[W, A, S, D]</color> Desplazarse por
    los salones de ballet\n\u2022 <color=#D8B468>[Rat\xF3n]</color> Observar el entorno
    e inspeccionar espejos\n\u2022 <color=#D8B468>[E]</color> Interactuar con puertas,
    documentos y mecanismos\n\u2022 <color=#D8B468>[Shift Izquierdo]</color> Correr\n\u2022
    <color=#D8B468>[Tab]</color> Consultar el Cuaderno de Investigaci\xF3n compartido\n\n<b>REGLAS
    CLAVE</b>\n\u2022 <b>Progreso Compartido:</b> Puertas, llaves y puzles tienen
    el mismo estado para ambos.\n\u2022 <b>Puzles Deducibles:</b> Las pistas nunca
    se pierden. Si un mecanismo falla, utiliza la palanca de reinicio."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
